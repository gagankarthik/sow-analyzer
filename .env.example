# =============================================================================
# Blue-IQ — environment variables
#
# Local dev:  copy this file to `.env.local` and fill in real values.
# Production: set each of these in your host's environment, for the build
#             step as well as the running server.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so they
# MUST exist when `next build` runs — a missing one ships as `undefined`.
# Everything without the prefix is server-only and must NEVER be exposed.
# =============================================================================

# --- Public client config (safe to expose; inlined at build time) ------------

# Backend API Gateway base URL — no trailing slash.
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com

# Default tenant id, sent as the `x-tenant-id` fallback header.

# Canonical site origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, sitemap.xml, robots.txt and structured data. Set it to the production
# domain; when unset the app falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://govern.blue-iq.ai

# AWS Cognito user pool — public client (SRP, no client secret).
# The amazon-cognito-identity-js SDK reads these in the browser.
NEXT_PUBLIC_COGNITO_REGION=us-east-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Govern "Later" features to show as live (lib/govern/features.ts). Comma list of
# routingRules, docusign, notifications, obligations, exports, integrations.
# Empty = all shown as "Coming soon". The API's GET /govern/me answer wins when present.
NEXT_PUBLIC_GOVERN_FEATURES=

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) --------------------

# OpenAI key used by the SOW drafter (app/api/sow/*). Required for AI drafting.
OPENAI_API_KEY=

# Optional — override the OpenAI model. Default: gpt-4.1-mini.
# OPENAI_MODEL=gpt-4.1-mini

# Optional — custom OpenAI-compatible base URL. Default: https://api.openai.com/v1.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — origin of the S3 bucket behind presigned uploads and previews, e.g.
# https://my-bucket.s3.us-east-2.amazonaws.com. Pins the Content-Security-Policy
# to that bucket; when unset, any S3 bucket in the API's region is allowed.
# CSP_STORAGE_ORIGIN=

# --- AI guardrails (lib/sow/guardrails.ts) ----------------------------------
# Provider that may receive data. Must be on the no-train allowlist (openai |
# openai-zdr) or SOW drafting fails closed. Use "openai-zdr" (with a ZDR
# OPENAI_BASE_URL) once Zero Data Retention is approved with OpenAI.
# AI_PROVIDER=openai
# Master switch for PII redaction before prompts leave the server. Default: true.
# (The no-train allowlist + audit log are always enforced.)
# GUARDRAILS_ENABLED=true
# Entity classes pseudonymised before sending. Default: EMAIL,PHONE,SSN,CREDIT_CARD,IP.
# REDACT_CLASSES=EMAIL,PHONE,SSN,CREDIT_CARD,IP
